# Nexus shared environment
# =========================
# Copy to `.env` at the repo root. Every package loads this file first, then its
# own `packages/<pkg>/.env` on top, so a package value always wins over a root
# value.
#
# Only variables that are shared by the pipeline belong here, and they are the
# only variables that stay unprefixed. Anything owned by a single package is
# named `RESEARCH_<PACKAGE>_*` (or `MORNING_RESEARCH_*`) and lives in that
# package's `.env`. See docs/environment.md for the full convention.

# Supabase — the pipeline's shared Postgres project (retired in Phase 5)
# consumed by: research_parser, research_analyst, research_dispatcher,
#              research-store, morning_research
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_or_anon_key

# Local PostgreSQL — canonical research database (Phases 2–5)
# Provision with: docker compose up -d postgres
# consumed by: research_parser, research_analyst, research_dispatcher (future)
# NEXUS_DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexus
# NEXUS_POSTGRES_USER=nexus
# NEXUS_POSTGRES_PASSWORD=nexus
# NEXUS_POSTGRES_DB=nexus
# NEXUS_POSTGRES_PORT=5432

# Google Drive — service account with read access to the research folder
# consumed by: research_parser, morning_research
GOOGLE_CREDENTIALS_PATH=/absolute/path/to/credentials/service-account.json
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id

# Checkout root used to locate the sibling `research_pipeline_ops` package.
# Leave unset outside containers; each package falls back to its own layout.
# consumed by: research_parser, research_analyst, research-store
# RESEARCH_PROCESSING_ROOT=/app

# Notion — workspace credentials and the LIBRARY database ids
# consumed by: morning_research
NOTION_TOKEN=
NOTION_DATABASE_ID=
# Page id used for the Area relation (Area=Job)
NOTION_AREA_PAGE_ID=

# LLM provider credentials. Account-scoped, so they stay unprefixed and live
# here even where only one package reads them today. A package that needs its
# own provider selection uses a prefixed var (for example
# RESEARCH_ANALYST_AGENT_LLM_API_KEY).
# consumed by: research_dispatcher
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPINFRA_API_KEY=
