RESEARCH_GLEANER_NOTION_DATA_SOURCE_ID=
RESEARCH_GLEANER_NOTION_TOPIC=Markets
RESEARCH_GLEANER_NOTION_RESOURCE_TYPES=Research Note,Commentary
RESEARCH_GLEANER_NOTION_SINCE=24h
# Optional comma-separated COLOR=INTENT entries, for example:
# RESEARCH_GLEANER_NOTION_ROUTES=yellow=research,blue=research,green=relay
RESEARCH_GLEANER_STATE_DB=~/.local/state/research-gleaner/gleaner.db
RESEARCH_GLEANER_LOCK_FILE=~/.local/state/research-gleaner/notion-sweep.lock
RESEARCH_GLEANER_REMARKABLE_SINCE=48h
# Optional comma-separated COLOR=INTENT entries, for example:
# RESEARCH_GLEANER_REMARKABLE_ROUTES=pink=research,yellow=relay
RESEARCH_GLEANER_REMARKABLE_LOCK_FILE=~/.local/state/research-gleaner/remarkable-sweep.lock
RESEARCH_GLEANER_OUTPUT_DIR=~/research-gleaner/out
