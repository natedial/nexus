{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://research-processing.local/schemas/run_receipt.schema.json",
  "title": "Morning Research Run Receipt",
  "description": "Summary written by Codex (or the DRY_RUN stub) at the end of a daily run.",
  "type": "object",
  "required": [
    "page_title",
    "documents_analyzed",
    "window_start",
    "window_end",
    "used_fallback_window"
  ],
  "properties": {
    "page_title": {
      "type": "string",
      "description": "Title of the Notion page to be created, e.g. 'Research from Jul 20 to Jul 24'."
    },
    "documents_analyzed": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Google Drive file_ids of documents given meaningful analytical treatment."
    },
    "documents_excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file_id", "reason"],
        "properties": {
          "file_id": { "type": "string" },
          "reason": { "type": "string" }
        }
      },
      "default": []
    },
    "window_start": {
      "type": "string",
      "format": "date-time"
    },
    "window_end": {
      "type": "string",
      "format": "date-time"
    },
    "used_fallback_window": {
      "type": "boolean"
    },
    "word_count": {
      "type": ["integer", "null"]
    },
    "exceptional_length_reason": {
      "type": ["string", "null"],
      "description": "Required justification if draft.md exceeds the 2,500-word hard limit."
    },
    "error": {
      "type": ["string", "null"],
      "description": "Set when the run could not complete; draft.md may be absent or partial."
    },
    "dry_run": {
      "type": "boolean",
      "default": false
    }
  },
  "additionalProperties": true
}
