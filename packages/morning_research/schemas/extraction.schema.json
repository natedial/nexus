{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://research-processing.local/schemas/extraction.schema.json",
  "title": "Per-Document Extraction",
  "description": "Structured extraction written by Codex for a single analyzed report, to extractions/{file_id}.json.",
  "type": "object",
  "required": ["file_id"],
  "properties": {
    "file_id": {
      "type": "string",
      "description": "Google Drive file id of the source PDF."
    },
    "institution": { "type": ["string", "null"] },
    "title": { "type": ["string", "null"] },
    "author": { "type": ["string", "null"] },
    "publication_date": { "type": ["string", "null"], "format": "date" },
    "topic": { "type": ["string", "null"] },
    "tier": {
      "type": ["string", "null"],
      "enum": [
        "Tier 1 — Portfolio-Relevant Development",
        "Tier 2 — Important Research Finding",
        "Tier 3 — Useful Supporting Evidence",
        "Tier 4 — Routine or Low-Signal Content",
        null
      ]
    },
    "core_thesis": { "type": ["string", "null"] },
    "whats_new": { "type": ["string", "null"] },
    "key_evidence": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "forecast_or_recommendation_change": { "type": ["string", "null"] },
    "horizon": { "type": ["string", "null"] },
    "catalysts": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "confirmation_falsification": { "type": ["string", "null"] },
    "rates_implications": { "type": ["string", "null"] },
    "caveats": { "type": ["string", "null"] },
    "confidence": { "type": ["string", "null"] },
    "quotations": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "summary": { "type": ["string", "null"] },
    "excluded_reason": {
      "type": ["string", "null"],
      "description": "Set when the document contained no substantive content worth extracting."
    }
  },
  "additionalProperties": true
}
