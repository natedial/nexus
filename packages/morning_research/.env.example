# Morning Research Configuration
# ==============================
# Copy this file to `.env` (in this package) and fill in your values.
#
# Shared credentials — GOOGLE_CREDENTIALS_PATH, GOOGLE_DRIVE_FOLDER_ID,
# NOTION_TOKEN, NOTION_DATABASE_ID, NOTION_AREA_PAGE_ID, SUPABASE_URL,
# SUPABASE_KEY — live in the repo-root `.env` (see ../../.env.example). This
# package loads the root file first, so only override them here when this
# package needs a different value.
#
# Everything below is owned by this package and prefixed MORNING_RESEARCH_. The
# old unprefixed names (CODEX_BIN, DRY_RUN, ...) still work as a deprecated
# fallback.

# Persistent run state. Defaults to the sibling local_codex state file so the
# migration from the legacy automation is transparent; point this at a new
# path once you no longer need continuity with local_codex.
MORNING_RESEARCH_STATE_PATH=/absolute/path/to/local_codex/state/research_digest_state.json

# Scratch space for each run (manifest, downloaded PDFs, prior notes, draft, receipt)
MORNING_RESEARCH_WORK_DIR=./work

# Codex CLI
MORNING_RESEARCH_CODEX_BIN=codex
MORNING_RESEARCH_CODEX_TIMEOUT_SECONDS=3600
MORNING_RESEARCH_CODEX_MODEL=

# Prefilter
MORNING_RESEARCH_MIN_PDF_BYTES=2048

# Set to true to skip Codex/Notion/Supabase calls entirely and write a stub
# receipt — useful for exercising the Drive-pull + prefilter + state plumbing.
MORNING_RESEARCH_DRY_RUN=false
