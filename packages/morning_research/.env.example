# Google Drive (service account with read access to the PDFs_as_Docs folder)
GOOGLE_CREDENTIALS_PATH=/Users/ncdial/devwork/local_codex/credentials/service-account.json
GOOGLE_DRIVE_FOLDER_ID=

# Notion
NOTION_TOKEN=
NOTION_DATABASE_ID=
# Area is a relation in LIBRARY — page ID for the Job area
NOTION_AREA_PAGE_ID=

# Supabase (optional — upsert steps are skipped with a warning if unset)
SUPABASE_URL=
SUPABASE_KEY=

# Persistent run state. Defaults to the sibling local_codex state file so the
# migration from the legacy automation is transparent; point this at a new
# path once you no longer need continuity with local_codex.
MORNING_RESEARCH_STATE_PATH=/Users/ncdial/devwork/local_codex/state/research_digest_state.json

# Scratch space for each run (manifest, downloaded PDFs, prior notes, draft, receipt)
MORNING_RESEARCH_WORK_DIR=./work

# Codex CLI
CODEX_BIN=codex
CODEX_TIMEOUT_SECONDS=3600
CODEX_MODEL=

# Prefilter
MIN_PDF_BYTES=2048

# Set to true to skip Codex/Notion/Supabase calls entirely and write a stub
# receipt — useful for exercising the Drive-pull + prefilter + state plumbing.
DRY_RUN=false
