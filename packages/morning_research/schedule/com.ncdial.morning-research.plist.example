<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copy to ~/Library/LaunchAgents/com.ncdial.morning-research.plist and run:
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.ncdial.morning-research.plist
  Adjust the Hour/Minute below to your desired daily run time (local time).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ncdial.morning-research</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/ncdial/devwork/research_processing/morning_research/schedule/run_daily.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/ncdial/devwork/research_processing/morning_research/work/logs/launchd.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/ncdial/devwork/research_processing/morning_research/work/logs/launchd.err.log</string>

    <key>RunAtLoad</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
