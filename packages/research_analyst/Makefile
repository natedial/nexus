IMAGE_NAME ?= research-analysis-layer
IMAGE_TAG ?= latest
CONTAINER_NAME ?= research-analysis-layer-hourly
ROOT_ENV_FILE ?= ../../.env
ENV_FILE ?= .env
# Shared root values first, package overrides second; both are optional.
ENV_FILE_FLAGS ?= $(if $(wildcard $(ROOT_ENV_FILE)),--env-file $(ROOT_ENV_FILE),) \
	$(if $(wildcard $(ENV_FILE)),--env-file $(ENV_FILE),)
HOST_STATE_DB_PATH ?= ../research_parser/data/state.db
HOST_ANALYSIS_DIR ?= $(CURDIR)/data
HOST_PIPELINE_OPS_DIR ?= ../research_pipeline_ops
CONTAINER_STATE_DB_PATH ?= /parser-data/state.db
CONTAINER_ANALYSIS_DIR ?= /data
RESEARCH_ANALYST_STATE_DB_PATH ?= $(CONTAINER_STATE_DB_PATH)
RESEARCH_ANALYST_ANALYSIS_DB_URL ?= sqlite:///$(CONTAINER_ANALYSIS_DIR)/analysis.db
RESEARCH_ANALYST_POLL_INTERVAL_SECONDS ?= 3600
RESEARCH_ANALYST_RUN_BATCH_LIMIT ?= 25
RESEARCH_ANALYST_MAX_BATCHES_PER_TICK ?= 8
RESEARCH_ANALYST_FORECAST_UPLOAD_LIMIT ?= 250

.PHONY: build run-hourly run-once stop logs shell doctor test

build:
	docker build -t $(IMAGE_NAME):$(IMAGE_TAG) .

run-hourly:
	docker run -d \
		--name $(CONTAINER_NAME) \
		--restart unless-stopped \
		$(ENV_FILE_FLAGS) \
		-e RESEARCH_PROCESSING_ROOT=/app \
		-e RESEARCH_ANALYST_STATE_DB_PATH=$(RESEARCH_ANALYST_STATE_DB_PATH) \
		-e RESEARCH_ANALYST_ANALYSIS_DB_URL=$(RESEARCH_ANALYST_ANALYSIS_DB_URL) \
		-e RESEARCH_ANALYST_POLL_INTERVAL_SECONDS=$(RESEARCH_ANALYST_POLL_INTERVAL_SECONDS) \
		-e RESEARCH_ANALYST_RUN_BATCH_LIMIT=$(RESEARCH_ANALYST_RUN_BATCH_LIMIT) \
		-e RESEARCH_ANALYST_MAX_BATCHES_PER_TICK=$(RESEARCH_ANALYST_MAX_BATCHES_PER_TICK) \
		-e RESEARCH_ANALYST_FORECAST_UPLOAD_LIMIT=$(RESEARCH_ANALYST_FORECAST_UPLOAD_LIMIT) \
		-v $(HOST_STATE_DB_PATH):$(CONTAINER_STATE_DB_PATH):ro \
		-v $(HOST_ANALYSIS_DIR):$(CONTAINER_ANALYSIS_DIR) \
		-v $(HOST_PIPELINE_OPS_DIR):/app/research_pipeline_ops:ro \
		$(IMAGE_NAME):$(IMAGE_TAG)

run-once:
	docker run --rm \
		$(ENV_FILE_FLAGS) \
		-e RESEARCH_PROCESSING_ROOT=/app \
		-e RESEARCH_ANALYST_STATE_DB_PATH=$(RESEARCH_ANALYST_STATE_DB_PATH) \
		-e RESEARCH_ANALYST_ANALYSIS_DB_URL=$(RESEARCH_ANALYST_ANALYSIS_DB_URL) \
		-e RESEARCH_ANALYST_RUN_BATCH_LIMIT=$(RESEARCH_ANALYST_RUN_BATCH_LIMIT) \
		-v $(HOST_STATE_DB_PATH):$(CONTAINER_STATE_DB_PATH):ro \
		-v $(HOST_ANALYSIS_DIR):$(CONTAINER_ANALYSIS_DIR) \
		-v $(HOST_PIPELINE_OPS_DIR):/app/research_pipeline_ops:ro \
		$(IMAGE_NAME):$(IMAGE_TAG) \
		python -m research_analysis_layer.main run --limit $(RESEARCH_ANALYST_RUN_BATCH_LIMIT)

doctor:
	docker run --rm \
		$(ENV_FILE_FLAGS) \
		-e RESEARCH_PROCESSING_ROOT=/app \
		-e RESEARCH_ANALYST_STATE_DB_PATH=$(RESEARCH_ANALYST_STATE_DB_PATH) \
		-e RESEARCH_ANALYST_ANALYSIS_DB_URL=$(RESEARCH_ANALYST_ANALYSIS_DB_URL) \
		-v $(HOST_STATE_DB_PATH):$(CONTAINER_STATE_DB_PATH):ro \
		-v $(HOST_ANALYSIS_DIR):$(CONTAINER_ANALYSIS_DIR) \
		-v $(HOST_PIPELINE_OPS_DIR):/app/research_pipeline_ops:ro \
		$(IMAGE_NAME):$(IMAGE_TAG) \
		python -m research_analysis_layer.main doctor

logs:
	docker logs -f $(CONTAINER_NAME)

shell:
	docker run --rm -it \
		$(ENV_FILE_FLAGS) \
		-e RESEARCH_PROCESSING_ROOT=/app \
		-e RESEARCH_ANALYST_STATE_DB_PATH=$(RESEARCH_ANALYST_STATE_DB_PATH) \
		-e RESEARCH_ANALYST_ANALYSIS_DB_URL=$(RESEARCH_ANALYST_ANALYSIS_DB_URL) \
		-v $(HOST_STATE_DB_PATH):$(CONTAINER_STATE_DB_PATH):ro \
		-v $(HOST_ANALYSIS_DIR):$(CONTAINER_ANALYSIS_DIR) \
		-v $(HOST_PIPELINE_OPS_DIR):/app/research_pipeline_ops:ro \
		$(IMAGE_NAME):$(IMAGE_TAG) \
		/bin/sh

stop:
	-docker stop $(CONTAINER_NAME)
	-docker rm $(CONTAINER_NAME)

test:
	PYTHONPATH=src python3 -m unittest discover -s tests
