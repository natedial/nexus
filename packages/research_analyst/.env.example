# Research Analyst Configuration
# ==============================
# Copy this file to `.env` (in this package) and adjust the values you need.
#
# Shared credentials — NEXUS_DATABASE_URL, RESEARCH_PROCESSING_ROOT — live in
# the repo-root `.env` (see ../../.env.example). This package reads the root
# file for those and only needs its own file for the settings below.
#
# Everything here is analyst-owned and prefixed RESEARCH_ANALYST_. The old
# unprefixed names (PARSED_DB_URL, ANALYST_DEBATE_MODE, ...) still work as a
# deprecated fallback.

# Stores
# ------
# Analysis store. Defaults to root NEXUS_DATABASE_URL; use sqlite:/// for local bootstrap.
RESEARCH_ANALYST_ANALYSIS_DB_URL=sqlite:///data/analysis.db
# Parsed/calendar reads. Default: root NEXUS_DATABASE_URL.
# RESEARCH_ANALYST_PARSED_DATABASE_URL=
# RESEARCH_ANALYST_CALENDAR_DATABASE_URL=
# economic_events or release_dates
RESEARCH_ANALYST_CALENDAR_MATCH_SOURCE=economic_events
RESEARCH_ANALYST_CALENDAR_SOURCE_NAME=
# Parser state database. Falls back to RESEARCH_PARSER_STATE_DB_PATH.
RESEARCH_ANALYST_STATE_DB_PATH=../research_parser/data/state.db
# Corpus search: research-store removed Phase 1. Tool schemas load from
# schemas/corpus_tool_schema.json; invocations fail until Phase 2/3 retrieval.
# Use Tholos instead, or inject a test client in unit tests.
# RESEARCH_ANALYST_THOLOS_ENABLED=true

# Batch behaviour
# ---------------
RESEARCH_ANALYST_BATCH_SIZE=25
RESEARCH_ANALYST_CRON_MODE_ENABLED=true
RESEARCH_ANALYST_REQUEST_TIMEOUT_SECONDS=30
RESEARCH_ANALYST_BATCH_OUT_DIR=/var/research/analyst

# Quality gates
# -------------
RESEARCH_ANALYST_MIN_FULL_TEXT_CHARS=500
RESEARCH_ANALYST_MIN_QUALITY_SCORE=0.6
RESEARCH_ANALYST_MIN_USABLE_THEME_RATIO=0.6
RESEARCH_ANALYST_BACKFILL_REQUIRE_WARNING_FREE=true

# Pipeline versions recorded on stored rows
# -----------------------------------------
RESEARCH_ANALYST_ANALYSIS_VERSION=argmap-v1
RESEARCH_ANALYST_CHUNKER_VERSION=deterministic-theme-v1
RESEARCH_ANALYST_ASSERTION_EXTRACTOR_VERSION=deterministic-theme-v1
RESEARCH_ANALYST_RESOLVER_VERSION=bootstrap-v1

# Agent execution
# ---------------
# Enabled automatically when an API key or the codex provider is configured.
RESEARCH_ANALYST_AGENT_EXECUTION_ENABLED=false
# openai, openai_compatible, or codex
RESEARCH_ANALYST_AGENT_LLM_PROVIDER=
# Package-scoped provider key. Point it at the same value as the root
# OPENAI_API_KEY when the analyst should use that account.
RESEARCH_ANALYST_AGENT_LLM_API_KEY=
RESEARCH_ANALYST_AGENT_LLM_BASE_URL=
RESEARCH_ANALYST_AGENT_LLM_CODEX_BIN=
RESEARCH_ANALYST_AGENT_LLM_CODEX_MODEL=
RESEARCH_ANALYST_AGENT_LLM_TIMEOUT_SECONDS=60
RESEARCH_ANALYST_AGENT_LLM_MAX_OUTPUT_TOKENS=16384
RESEARCH_ANALYST_AGENT_LLM_REASONING_EFFORT=

# Rounds, tools, and debate
# ------------------------
RESEARCH_ANALYST_ROUND_MODE=rounds
RESEARCH_ANALYST_TOOLS_ENABLED=false
# off, shadow, or on
RESEARCH_ANALYST_DEBATE_MODE=off
RESEARCH_ANALYST_DEBATE_JUDGE_MODEL=
RESEARCH_ANALYST_MAX_DEBATE_ARGUMENTS=8

# Resolution and consensus
# ------------------------
# coarse or fine
RESEARCH_ANALYST_REFERENT_GRANULARITY=coarse
RESEARCH_ANALYST_CONSENSUS_MIN_PUBLISHERS=2
RESEARCH_ANALYST_CONSENSUS_SHIFT_DIVERSITY_THRESHOLD=3
# off: compute stays off the published digest
# shadow: compute + persist + log; current digest authoritative
# on: street-agrees section is live on the dispatcher snapshot and PDF
RESEARCH_ANALYST_DIGEST_CONSENSUS_MODE=off

# Tholos calendar service
# -----------------------
RESEARCH_ANALYST_THOLOS_ENABLED=false
RESEARCH_ANALYST_THOLOS_BASE_URL=http://localhost:8004
RESEARCH_ANALYST_THOLOS_TIMEOUT_SECONDS=30

# Evals
# -----
RESEARCH_ANALYST_EVAL_CAPTURE_ENABLED=false
RESEARCH_ANALYST_EVAL_CAPTURES_DIR=evals/captures
# Argument-judge rubric weights (must be >= 0). Normalized at score time;
# not pass/fail cutoffs.
RESEARCH_ANALYST_ARGUMENT_JUDGE_WEIGHT_RATIONALE_FIDELITY=0.25
RESEARCH_ANALYST_ARGUMENT_JUDGE_WEIGHT_SUBSTANTIVE=0.25
RESEARCH_ANALYST_ARGUMENT_JUDGE_WEIGHT_GROUNDEDNESS=0.25
RESEARCH_ANALYST_ARGUMENT_JUDGE_WEIGHT_PHANTOM=0.25
# Promotion gate for DIGEST_CONSENSUS_MODE shadow → on. Floors are 0–1;
# defaults never fail. Advisory until a baseline file exists, then
# blocking mode may refuse promotion.
RESEARCH_ANALYST_PROMOTION_GATE_MODE=advisory
RESEARCH_ANALYST_PROMOTION_GATE_BASELINE_PATH=evals/baselines/rubric_rates.json
RESEARCH_ANALYST_PROMOTION_GATE_FLOOR_CLAIM_RATIONALE=0
RESEARCH_ANALYST_PROMOTION_GATE_FLOOR_CLAIM_EVIDENCED=0
RESEARCH_ANALYST_PROMOTION_GATE_FLOOR_DIVERGENCE_GROUNDED=0
RESEARCH_ANALYST_PROMOTION_GATE_FLOOR_DIVERGENCE_ATTRIBUTED=0
RESEARCH_ANALYST_PROMOTION_GATE_FLOOR_CONSENSUS_MULTI_SOURCE=0

# Gold argument maps (evals/gold_set.py)
# --------------------------------------
# Private checkout holding gold records and source texts. Must be outside this
# repository, which is public. The gold command refuses paths inside it.
# RESEARCH_ANALYST_GOLD_DIR=~/devwork/nexus-gold

# Hourly runner (scripts/hourly_runner.sh)
# ----------------------------------------
RESEARCH_ANALYST_POLL_INTERVAL_SECONDS=3600
RESEARCH_ANALYST_RUN_BATCH_LIMIT=25
RESEARCH_ANALYST_MAX_BATCHES_PER_TICK=8
RESEARCH_ANALYST_FORECAST_UPLOAD_LIMIT=250
