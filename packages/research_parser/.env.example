# Research Parser Configuration
# ==============================
# Copy this file to `.env` (in this package) and fill in your values.
#
# Shared credentials — NEXUS_DATABASE_URL, GOOGLE_CREDENTIALS_PATH,
# GOOGLE_DRIVE_FOLDER_ID, RESEARCH_PROCESSING_ROOT — live in the repo-root
# `.env` (see ../../.env.example). This package loads the root file first, so
# only override them here when this package needs a different value.
#
# Parser storage uses PostgreSQL (Phase 2). Default: root NEXUS_DATABASE_URL.
# RESEARCH_PARSER_DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexus
#
# Everything below is parser-owned and prefixed RESEARCH_PARSER_. The old
# unprefixed names still work as a fallback, but they are deprecated.

# Processing Settings
# -------------------
RESEARCH_PARSER_POLL_INTERVAL_MINUTES=5
RESEARCH_PARSER_CATCHUP_DAYS=0
# Only consider Drive files created on/after this date (YYYY-MM-DD, UTC)
RESEARCH_PARSER_DRIVE_SINCE_DATE=
RESEARCH_PARSER_STATE_DB_PATH=./data/state.db
RESEARCH_PARSER_ARTIFACT_BASE_DIR=./data/artifacts

# Parsing
# -------
# Local Docling is the default parser. MinerU is an optional local CLI fallback.
RESEARCH_PARSER_MINERU_ENABLED=false
RESEARCH_PARSER_MINERU_BIN_PATH=
RESEARCH_PARSER_MINERU_BACKEND=pipeline
RESEARCH_PARSER_MINERU_TIMEOUT_SECONDS=300

# Retry Docling with OCR only when the digital parse looks thin or gappy.
RESEARCH_PARSER_DOCLING_OCR_RETRY=true

# Relay intake (R2/R3) — scan handoff bundles from research-relay after archive
# RESEARCH_PARSER_RELAY_INTAKE_DIR=/var/research/intake

# Retries
# -------
RESEARCH_PARSER_MAX_RETRIES=3
RESEARCH_PARSER_RETRY_DELAY_SECONDS=5
RESEARCH_PARSER_STALE_PROCESSING_TIMEOUT_MINUTES=30

# For Docker, use:
# RESEARCH_PARSER_STATE_DB_PATH=/app/data/state.db
# RESEARCH_PARSER_ARTIFACT_BASE_DIR=/app/data/artifacts
# GOOGLE_CREDENTIALS_PATH=/app/credentials/service-account.json  (root .env)
