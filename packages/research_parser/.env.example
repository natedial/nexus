# Research Parser Configuration
# ==============================
# Copy this file to .env and fill in your values

# Google Drive
# ------------
GOOGLE_CREDENTIALS_PATH=./credentials/service-account.json
GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here

# Supabase
# --------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Processing Settings
# -------------------
POLL_INTERVAL_MINUTES=5
CATCHUP_DAYS=0
STATE_DB_PATH=./data/state.db
ARTIFACT_BASE_DIR=./data/artifacts

# Parsing
# -------
# Local Docling is the default parser. MinerU is an optional local CLI fallback.
MINERU_ENABLED=false
MINERU_BIN_PATH=
MINERU_BACKEND=pipeline
MINERU_TIMEOUT_SECONDS=300

# Retry Docling with OCR only when the digital parse looks thin or gappy.
DOCLING_OCR_RETRY=true

# For Docker, use:
# STATE_DB_PATH=/app/data/state.db
# GOOGLE_CREDENTIALS_PATH=/app/credentials/service-account.json
# ARTIFACT_BASE_DIR=/app/data/artifacts
