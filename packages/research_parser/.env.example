# Research Parser Configuration
# ==============================
# Copy this file to .env and fill in your values

# Google Drive
# ------------
# Path to your service account JSON credentials
GOOGLE_CREDENTIALS_PATH=./credentials/service-account.json

# Folder ID from the Google Drive URL
# Example: https://drive.google.com/drive/folders/ABC123 -> ABC123
GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here

# LLM API Keys
# ------------
# Anthropic API key (optional, only needed if using Anthropic models)
ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI API key (optional, only needed if using OpenAI models in config/models.yaml)
OPENAI_API_KEY=sk-...

# Groq API key (optional, only needed if using Groq models)
GROQ_API_KEY=gsk_...

# DeepInfra API key (optional, only needed if using DeepInfra models)
DEEPINFRA_API_KEY=...

# Fireworks API key (optional, only needed if using Fireworks models)
FIREWORKS_API_KEY=...

# Together API key (optional, only needed if using Together models)
TOGETHER_API_KEY=...

# LlamaIndex Cloud
# ----------------
# API key for PDF parsing
LLAMAINDEX_API_KEY=llx-...

# Supabase
# --------
# Your Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Service role key (not anon key) for write access
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Processing Settings
# -------------------
# How often to poll Google Drive for new files (minutes)
POLL_INTERVAL_MINUTES=5
# On startup, process files from the last N days (0 disables)
CATCHUP_DAYS=0

# Local State (Development)
# -------------------------
# For local development, use a local path
STATE_DB_PATH=./data/state.db

# Optional MinerU CLI Fallback
# ----------------------------
# Enable MinerU as a parser fallback between Docling and LlamaIndex.
MINERU_ENABLED=false

# Absolute path to the MinerU CLI installed in a separate venv or via pipx.
# Example: /opt/mineru-venv/bin/mineru
MINERU_BIN_PATH=

# MinerU CLI backend to use (official README recommends "pipeline" for CPU).
MINERU_BACKEND=pipeline

# Timeout for a single MinerU parse in seconds.
MINERU_TIMEOUT_SECONDS=300

# For Docker, use:
# STATE_DB_PATH=/app/data/state.db
