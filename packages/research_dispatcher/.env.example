# Research Dispatcher Configuration
# =================================
# Copy this file to `.env` (in this package) and fill in your values.
#
# Shared credentials — SUPABASE_URL, SUPABASE_KEY, ANTHROPIC_API_KEY,
# OPENAI_API_KEY, OPENROUTER_API_KEY, DEEPINFRA_API_KEY — live in the repo-root
# `.env` (see ../../.env.example). This package loads the root file first, so
# only override them here when the dispatcher needs a different value.
#
# Everything below is dispatcher-owned and prefixed RESEARCH_DISPATCHER_. The
# old unprefixed names (MODE, SMTP_PASSWORD, FILTER_REGION, ...) still work as a
# deprecated fallback.

# Synthesis
# ---------
# Enable/disable cross-document synthesis (default: true)
RESEARCH_DISPATCHER_ENABLE_SYNTHESIS=true

# Use skill-based two-stage pipeline instead of monolithic prompt (default: false)
# false = single LLM call with prompts/synthesis.md
# true = two-stage: throughline-synthesizer -> callout-extractor
RESEARCH_DISPATCHER_USE_SKILL_PIPELINE=false

# Email
# -----
RESEARCH_DISPATCHER_SMTP_SERVER=smtp.gmail.com
RESEARCH_DISPATCHER_SMTP_PORT=587
RESEARCH_DISPATCHER_SMTP_USERNAME=your_email@gmail.com
RESEARCH_DISPATCHER_SMTP_PASSWORD=your_app_password_here
RESEARCH_DISPATCHER_EMAIL_FROM=your_email@gmail.com
# Single recipient or comma-separated list
# Example: RESEARCH_DISPATCHER_EMAIL_TO=alice@example.com, bob@example.com
RESEARCH_DISPATCHER_EMAIL_TO=recipient@example.com

# Report
# ------
RESEARCH_DISPATCHER_REPORT_TITLE=Document Analysis Report

# Input source: parser (query Supabase) or analyst (read a batch file)
RESEARCH_DISPATCHER_INPUT_MODE=parser
RESEARCH_DISPATCHER_ANALYST_BATCH_PATH=
# Local dispatch history database
RESEARCH_DISPATCHER_DB_PATH=state/dispatch_history.db

# Mode: debug (doesn't update synthesized flag) or production (updates it)
RESEARCH_DISPATCHER_MODE=debug

# Parser-mode production safety: mark sent parser records as synthesized so they
# are not selected again on the next run. Set false only for ledger-only analyst
# batch deployments.
RESEARCH_DISPATCHER_LEGACY_SYNTHESIZED_UPDATES=true

# Filters
# -------
# Number of days to look back for research documents (default: 3)
RESEARCH_DISPATCHER_DATE_RANGE_DAYS=7

# Comma-separated list of sources to filter by (empty = all sources)
# Example: RESEARCH_DISPATCHER_FILTER_SOURCES=Goldman Sachs,JP Morgan,Barclays
RESEARCH_DISPATCHER_FILTER_SOURCES=

# Filter by region from document metadata (empty = all regions)
# Options: US, EU, UK, Japan, China, EM, Global
RESEARCH_DISPATCHER_FILTER_REGION=

# Filter by asset focus from document metadata (empty = all assets)
# Options: rates, credit, FX, equities, commodities, multi-asset
RESEARCH_DISPATCHER_FILTER_ASSET_FOCUS=

# Filter trades by minimum conviction level (default: high)
# Options: high (only high), medium (medium+high), all (all)
# `low` is accepted as a legacy alias for `all`
RESEARCH_DISPATCHER_FILTER_TRADE_CONVICTION=high

# Country for economic and supply calendar events (default: US)
RESEARCH_DISPATCHER_CALENDAR_COUNTRY=US

# Interactive Links (Feedback and Document Viewer)
# ------------------------------------------------
# Enable clickable links in PDF for feedback and viewing full document text
# Requires deploying Supabase Edge Functions (see supabase/functions/)
RESEARCH_DISPATCHER_FEEDBACK_ENABLED=false
RESEARCH_DISPATCHER_FEEDBACK_BASE_URL=
RESEARCH_DISPATCHER_DOCUMENT_VIEWER_URL=
# Required when feedback links are enabled
RESEARCH_DISPATCHER_DOCUMENT_LINK_SECRET=
RESEARCH_DISPATCHER_DOCUMENT_LINK_TTL_DAYS=7
